    "This Mac's clock is more than a day ahead: nothing is sent until it is corrected." : {
      "comment" : "Settings > Sync: warning: clock far ahead",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Uhr dieses Macs geht mehr als einen Tag vor: Bis sie korrigiert ist, wird nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reloj de este Mac va más de un día adelantado: no se envía nada hasta que se corrija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'horloge de ce Mac a plus d'un jour d'avance : rien n'est envoyé tant qu'elle n'est pas corrigée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'orologio di questo Mac è avanti di più di un giorno: non viene inviato nulla finché non è corretto."
          }
        }
      }
    },
    "This Mac's clock is off. Check the date and time in System Settings." : {
      "comment" : "Settings > Sync: warning: clock off",
      "localizations" : {
        "de" : {
