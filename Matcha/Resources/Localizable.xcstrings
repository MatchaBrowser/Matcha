{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” needs a user name and password." : {
      "comment" : "Page shown when a website's login was cancelled; %@ is the website",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ benötigt einen Benutzernamen und ein Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” necesita un nombre de usuario y una contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » demande un nom d'utilisateur et un mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” richiede un nome utente e una password."
          }
        }
      }
    },
    "“%@” Requests Additional Access" : {
      "comment" : "Alert shown when a browser extension asks for more permissions; %@ is the extension name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ fordert zusätzlichen Zugriff an"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” solicita acceso adicional"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » demande un accès supplémentaire"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” richiede un accesso aggiuntivo"
          }
        }
      }
    },
    "“%@” was moved, or Matcha can no longer read it since it was reopened. Choose it again to open it." : {
      "comment" : "Page shown when a local file can't be read; %@ is the file's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wurde verschoben oder Matcha kann die Datei seit dem erneuten Öffnen nicht mehr lesen. Wähle sie erneut aus, um sie zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” se ha movido o Matcha ya no puede leerlo desde que se volvió a abrir. Vuelve a elegirlo para abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a été déplacé, ou Matcha ne peut plus le lire depuis sa réouverture. Choisissez-le de nouveau pour l'ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” è stato spostato, oppure Matcha non può più leggerlo da quando è stato riaperto. Sceglilo di nuovo per aprirlo."
          }
        }
      }
    },
    "%@ is ready." : {
      "comment" : "Settings > Sync: the checked server answers (host name)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist bereit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è pronto."
          }
        }
      }
    },
    "%@ of %@" : {
