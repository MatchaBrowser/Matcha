      }
    },
    "It stops syncing and keeps its data. Signing in again reconnects it." : {
      "comment" : "Settings > Sync: disconnecting a device",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hört auf zu synchronisieren und behält seine Daten. Eine neue Anmeldung verbindet es wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja de sincronizar y conserva sus datos. Volver a iniciar sesión lo reconecta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il arrête de se synchroniser et garde ses données. Se reconnecter le remet en route."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smette di sincronizzarsi e conserva i suoi dati. Accedendo di nuovo si riconnette."
          }
        }
      }
    },
    "It will be able to:" : {
