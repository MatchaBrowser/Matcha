        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweiterungen können die Seiten lesen und ändern, auf die sie Zugriff haben. Füge nur Erweiterungen hinzu, denen du vertraust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las extensiones pueden leer y cambiar las páginas a las que tienen acceso. Añade solo extensiones de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les extensions peuvent lire et modifier les pages auxquelles elles ont accès. N'ajoutez que des extensions de confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le estensioni possono leggere e modificare le pagine a cui hanno accesso. Aggiungi solo estensioni di cui ti fidi."
