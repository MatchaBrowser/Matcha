    "You will be signed out of all websites; a password typed in a login sheet is kept until you quit Matcha. This action cannot be undone." : {
      "comment" : "Settings > Privacy: confirmation message before clearing the data of all websites",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst von allen Websites abgemeldet; ein in einem Anmeldefenster eingegebenes Passwort bleibt erhalten, bis du Matcha beendest. Diese Aktion kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará tu sesión en todos los sitios web; una contraseña escrita en una ventana de inicio de sesión se conserva hasta que salgas de Matcha. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez déconnecté de tous les sites ; un mot de passe saisi dans une feuille d'identification est gardé jusqu'à ce que vous quittiez Matcha. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrai disconnesso da tutti i siti web; una password inserita in una finestra di accesso viene conservata finché non esci da Matcha. Questa azione non può essere annullata."
          }
        }
      }
    },
    "You will be signed out of this website; a password typed in a login sheet is kept until you quit Matcha. The page will reload." : {
      "comment" : "Site settings: confirmation message before clearing the data of one website",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst von dieser Website abgemeldet; ein in einem Anmeldefenster eingegebenes Passwort bleibt erhalten, bis du Matcha beendest. Die Seite wird neu geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará tu sesión en este sitio web; una contraseña escrita en una ventana de inicio de sesión se conserva hasta que salgas de Matcha. La página se volverá a cargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez déconnecté de ce site ; un mot de passe saisi dans une feuille d'identification est gardé jusqu'à ce que vous quittiez Matcha. La page sera rechargée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrai disconnesso da questo sito web; una password inserita in una finestra di accesso viene conservata finché non esci da Matcha. La pagina verrà ricaricata."
          }
        }
      }
    },
    "Your data isn't encrypted again. Your other Macs are disconnected and ask for the new password." : {
      "comment" : "Settings > Sync: password change sheet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten werden nicht neu verschlüsselt. Deine anderen Macs werden getrennt und fragen nach dem neuen Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos no se vuelven a cifrar. Tus otros Mac se desconectan y piden la nueva contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données ne sont pas rechiffrées. Vos autres Mac sont déconnectés et demandent le nouveau mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati non vengono cifrati di nuovo. Gli altri Mac vengono disconnessi e chiedono la nuova password."
          }
        }
      }
    },
    "Your Homepage" : {
      "comment" : "Option of “New tabs open with”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startseite"
