    "Press this shortcut in any app to open a mini window, even when Matcha is in the background. It uses the profile of the Space shown." : {
      "comment" : "Settings > General: note under the mini window shortcut",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke diesen Kurzbefehl in einer beliebigen App, um ein Mini-Fenster zu öffnen, auch wenn Matcha im Hintergrund ist. Es verwendet das Profil des angezeigten Space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa este atajo en cualquier app para abrir una miniventana, incluso con Matcha en segundo plano. Usa el perfil del Space que se muestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur ce raccourci dans n'importe quelle app pour ouvrir une mini-fenêtre, même quand Matcha est en arrière-plan. Elle utilise le profil du Space affiché."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi questa scorciatoia in qualsiasi app per aprire una minifinestra, anche quando Matcha è in secondo piano. Usa il profilo dello Space mostrato."
          }
        }
      }
    },
