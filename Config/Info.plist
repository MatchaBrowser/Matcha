<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys Xcode can't generate (INFOPLIST_KEY_…), merged with the generated ones (GENERATE_INFOPLIST_FILE).
	     Websites in http: web views are exempt from App Transport Security (audit K4); the app's own requests (sync,
	     suggestions, icons) stay under it. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<!-- Category in the Finder and the App Store (audit A1): a web browser is a productivity app. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<!-- Export compliance (audit A4), read by App Store Connect only: sync encrypts the browsing data end to end
	     (SYNC.md § 3), which is not one of the exempt uses (authentication, the system's HTTPS alone). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<!-- Full version of a published build (“1.0.0-beta.1”), shown by About Matcha (AboutVersion): given by
	     scripts/package.sh and scripts/release.sh, empty otherwise. -->
	<key>MatchaReleaseVersion</key>
	<string>$(MATCHA_RELEASE_VERSION)</string>
</dict>
</plist>
