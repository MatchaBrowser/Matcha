    "Tabs" : {
      "comment" : "Menu bar menu: next and previous tab, first favorites and pinned tabs (⌘1 to ⌘8), last tab",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pestañas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onglets"
