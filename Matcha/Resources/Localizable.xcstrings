    "What you type in the command bar is sent to %@ to suggest searches. Never in private windows." : {
      "comment" : "Settings > General: note under the search suggestions toggle; %@ is the search engine name (Google, DuckDuckGo, Bing)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du in die Befehlsleiste tippst, wird an %@ gesendet, um Suchbegriffe vorzuschlagen. Nie in privaten Fenstern."
          }
        },
        "es" : {
          "stringUnit" : {
